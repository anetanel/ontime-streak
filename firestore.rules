rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules whenever it
// changes — there's no CLI/npm in this project's toolchain, so this file is
// the source of truth but isn't auto-deployed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          "netanel.attali@gmail.com",
          "dovnemalim@gmail.com"
        ];
    }

    // Each admin only ever has full access to their OWN household —
    // this is what keeps test data and real data completely separate.
    function isOwner(ownerId) {
      return isAdmin() && request.auth.uid == ownerId;
    }

    function isGuestOf(ownerId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/guestGrants/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/guestGrants/$(request.auth.uid)).data.householdId == ownerId;
    }

    function isActiveInviteFor(inviteId, ownerId) {
      let invite = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return invite.active == true && invite.ownerId == ownerId;
    }

    // Admin-created invite links (see README for how to create one). Each
    // invite names which admin's household (by uid, in ownerId) it grants
    // guest access to. A guest only needs to read the one they redeem.
    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // A guest "claims" an invite once, by creating their own grant doc —
    // this is what actually gates their access below. The create is only
    // allowed if it references a real, still-active invite, and the
    // household being claimed matches that invite's own ownerId.
    match /guestGrants/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && isActiveInviteFor(request.resource.data.invite, request.resource.data.householdId);
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // Each admin's own household. Guests only ever see achievements and
    // comments for the one specific household their invite grants — never
    // check-in history, shifts, settings, or the other admin's household.
    match /households/{ownerId}/prizeAwards/{date} {
      allow read: if isOwner(ownerId) || isGuestOf(ownerId);
    }

    match /households/{ownerId}/comments/{commentId} {
      allow read: if isOwner(ownerId) || isGuestOf(ownerId);
      allow create: if isGuestOf(ownerId) && request.resource.data.authorUid == request.auth.uid;
    }

    match /households/{ownerId}/{document=**} {
      allow read, write: if isOwner(ownerId);
    }
  }
}
